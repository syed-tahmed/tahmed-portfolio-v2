@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=JetBrains+Mono:wght@400;500&family=Inter:wght@400&display=swap');

.cj{position:relative;height:100vh;height:100svh;color:#fbf6ea}
.cj-stage{position:absolute;inset:0;background:#cdd5d6;overflow:hidden;will-change:clip-path}
.cj canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.cj-vignette{position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(130% 95% at 50% 50%,transparent 55%,rgba(20,28,18,.38) 100%),
             linear-gradient(180deg,rgba(20,28,18,.22),transparent 20%,transparent 48%,rgba(18,26,16,.62))}
.cj-grain{position:absolute;inset:0;pointer-events:none;opacity:.05;mix-blend-mode:overlay;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>")}
.cj-frame{position:absolute;inset:1.1rem;border:1px solid rgba(255,248,230,.28);pointer-events:none}

/* chapter list */
.cj-nav{position:absolute;left:2.8rem;top:58%;margin:0;padding:0;list-style:none;
  font:400 .72rem/1 'JetBrains Mono',ui-monospace,monospace;letter-spacing:.32em;text-transform:uppercase;
  text-shadow:0 1px 8px rgba(10,16,8,.55)}
.cj-nav li{position:relative;padding:.85rem 0;color:rgba(251,246,234,.45);transition:color .6s}
.cj-nav li.is-active{color:#fbf6ea}
.cj-nav li::before{content:"";position:absolute;left:-1.4rem;top:50%;width:7px;height:7px;margin-top:-3.5px;
  background:#e9b866;opacity:0;transition:opacity .6s}
.cj-nav li.is-active::before{opacity:1}

/* chapter text */
.cj-text{position:absolute;inset:0;pointer-events:none}
.cj-ch{position:absolute;left:50%;bottom:16vh;width:min(46rem,86vw);text-align:center;
  opacity:0;visibility:hidden;transform:translate(-50%,26px);
  transition:opacity 1.1s ease,transform 1.1s ease,visibility 0s 1.1s}
.cj-ch.is-active{opacity:1;visibility:visible;transform:translate(-50%,0);
  transition:opacity 1.1s ease .3s,transform 1.1s ease .3s,visibility 0s}
.cj-ch h2{margin:0;font:700 clamp(1.9rem,4.6vw,3.6rem)/1.05 'Space Grotesk',system-ui,sans-serif;
  text-transform:uppercase;letter-spacing:.01em;text-shadow:0 2px 24px rgba(10,16,8,.55)}
.cj-ch p{margin:1.3rem auto 0;max-width:34rem;font:400 clamp(.95rem,1.4vw,1.1rem)/1.7 'Inter',system-ui,sans-serif;
  color:rgba(251,246,234,.82);text-shadow:0 1px 14px rgba(10,16,8,.6)}
.cj-ch--final h2{font-size:clamp(1.5rem,3.4vw,2.8rem);max-width:22ch;margin-inline:auto}
.cj-ch--final p{color:rgba(255,250,238,.92)}

/* chamfered button */
.cj-btn{--c:14px;display:inline-block;margin-top:2rem;padding:1px;text-decoration:none;pointer-events:auto;
  background:rgba(233,184,102,.75);
  clip-path:polygon(0 0,calc(100% - var(--c)) 0,100% var(--c),100% 100%,var(--c) 100%,0 calc(100% - var(--c)));
  transition:background .5s}
.cj-btn span{display:flex;align-items:center;gap:.8rem;padding:1.05rem 2rem;background:rgba(20,32,26,.88);color:#fbf6ea;
  font:500 .78rem/1 'JetBrains Mono',ui-monospace,monospace;letter-spacing:.24em;text-transform:uppercase;
  clip-path:polygon(0 0,calc(100% - var(--c)) 0,100% var(--c),100% 100%,var(--c) 100%,0 calc(100% - var(--c)));
  transition:background .5s,color .5s}
.cj-btn i{width:7px;height:7px;background:#e9b866;transition:background .5s}
.cj-btn:hover span,.cj-btn:focus-visible span{background:#fbf6ea;color:#14201a}
.cj-btn:hover i,.cj-btn:focus-visible i{background:#14201a}
.cj-btn:focus-visible{outline:2px solid #fbf6ea;outline-offset:3px}

/* bottom bar */
.cj-bar{position:absolute;left:1.1rem;right:1.1rem;bottom:1.1rem;height:54px;display:flex;align-items:center;gap:1.4rem;
  padding:0 2rem;border-top:1px solid rgba(255,248,230,.28);
  font:400 .7rem/1 'JetBrains Mono',ui-monospace,monospace;letter-spacing:.28em;text-transform:uppercase;
  color:rgba(251,246,234,.82);text-shadow:0 1px 8px rgba(10,16,8,.5)}
.cj-track{flex:1;height:2px;background:rgba(255,248,230,.25);overflow:hidden}
.cj-fill{height:100%;background:#e9b866;transform:scaleX(0);transform-origin:0 50%;will-change:transform}
.cj-bar-r b{font-weight:500;color:#fbf6ea;font-variant-numeric:tabular-nums}

@media (max-width:700px){
  .cj-nav{display:none}
  .cj-ch{bottom:13vh}
  .cj-bar{padding:0 1rem;gap:.8rem;letter-spacing:.16em}
  .cj-bar-l{display:none}
}

/* static / reduced-motion / no-WebGL fallback */
.cj--static{height:auto;min-height:100vh}
.cj--static .cj-stage{background:linear-gradient(180deg,#8fb0d4 0%,#cdd5d6 42%,#6f7f48 70%,#3a4a2c 100%)}
.cj--static .cj-ch{transition:none}
@media (prefers-reduced-motion:reduce){
  .cj-ch,.cj-ch.is-active{transition:none}
  .cj-stage{clip-path:none!important}
}
