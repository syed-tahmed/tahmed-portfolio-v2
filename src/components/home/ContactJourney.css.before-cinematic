.contact-journey {
  position: relative;
  overflow: hidden;
  min-height: 220vh;
  padding: 10rem 0 9rem;
  background:
    radial-gradient(circle at 50% 18%, rgba(89, 108, 155, 0.16), transparent 27rem),
    radial-gradient(circle at 20% 70%, rgba(75, 91, 135, 0.12), transparent 25rem),
    #080a10;
  color: #fff;
  isolation: isolate;
}

.contact-journey__glow {
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background:
    linear-gradient(
      90deg,
      transparent 0%,
      rgba(255,255,255,0.025) 50%,
      transparent 100%
    );
}

.contact-journey__intro {
  width: min(1100px, calc(100% - 40px));
  margin: 0 auto;
  text-align: center;
}

.contact-journey__eyebrow {
  display: inline-block;
  margin-bottom: 1.5rem;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.48);
}

.contact-journey__intro h2 {
  margin: 0;
  font-size: clamp(3.3rem, 8vw, 8.5rem);
  line-height: 0.86;
  letter-spacing: -0.065em;
  font-weight: 700;
}

.contact-journey__intro h2 span {
  color: rgba(255,255,255,0.3);
}

.contact-journey__intro p {
  margin: 2rem auto 0;
  color: rgba(255,255,255,0.5);
  font-size: 0.95rem;
  line-height: 1.7;
}

.contact-journey__path {
  position: relative;
  width: min(1100px, calc(100% - 40px));
  min-height: 1250px;
  margin: 6rem auto 0;
  perspective: 1600px;
}

.contact-journey__line {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 1px;
  transform: translateX(-50%);
  background: linear-gradient(
    to bottom,
    transparent,
    rgba(255,255,255,0.35) 15%,
    rgba(255,255,255,0.2) 80%,
    transparent
  );
  transform-origin: top center;
}

.contact-journey__card {
  position: absolute;
  width: min(420px, 38vw);
  transform-style: preserve-3d;
  border: 1px solid rgba(255,255,255,0.13);
  background: rgba(255,255,255,0.045);
  box-shadow:
    0 45px 100px rgba(0,0,0,0.45),
    inset 0 1px 0 rgba(255,255,255,0.08);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  overflow: hidden;
  will-change: transform;
}

.contact-journey__card--1 {
  top: 40px;
  left: 4%;
  border-radius: 28px 28px 90px 28px;
}

.contact-journey__card--2 {
  top: 440px;
  right: 4%;
  border-radius: 90px 28px 28px 28px;
}

.contact-journey__card--3 {
  top: 840px;
  left: 15%;
  border-radius: 28px 90px 28px 28px;
}

.contact-journey__image-wrap {
  position: relative;
  height: 300px;
  overflow: hidden;
}

.contact-journey__image {
  width: 100%;
  height: 115%;
  display: block;
  object-fit: cover;
  transform: scale(1.04);
  will-change: transform;
  filter: saturate(0.72) contrast(1.08);
}

.contact-journey__image-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to bottom, transparent 35%, rgba(4,5,9,0.8)),
    linear-gradient(135deg, rgba(255,255,255,0.08), transparent 45%);
}

.contact-journey__card-info {
  padding: 1.35rem 1.5rem 1.6rem;
}

.contact-journey__card-info span {
  color: rgba(255,255,255,0.38);
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.contact-journey__card-info h3 {
  margin: 0.55rem 0 0;
  font-size: clamp(1.25rem, 2vw, 1.65rem);
  line-height: 1.05;
  letter-spacing: -0.035em;
}

.contact-journey__final {
  position: relative;
  width: min(900px, calc(100% - 40px));
  margin: 3rem auto 0;
  padding: 8rem 2rem;
  text-align: center;
}

.contact-journey__final h2 {
  margin: 0;
  font-size: clamp(3rem, 7vw, 7rem);
  line-height: 0.9;
  letter-spacing: -0.065em;
}

.contact-journey__final h2 em {
  color: rgba(255,255,255,0.32);
  font-style: normal;
}

.contact-journey__button {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  margin-top: 3rem;
  padding: 1rem 1.5rem;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 999px;
  color: #fff;
  background: rgba(255,255,255,0.08);
  text-decoration: none;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  transition:
    transform 0.35s ease,
    background 0.35s ease,
    border-color 0.35s ease;
}

.contact-journey__button:hover {
  transform: translateY(-4px);
  background: rgba(255,255,255,0.15);
  border-color: rgba(255,255,255,0.4);
}

.contact-journey__final-orbit {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 460px;
  height: 460px;
  transform: translate(-50%, -50%);
  pointer-events: none;
  opacity: 0.3;
}

.contact-journey__final-orbit span {
  position: absolute;
  inset: 0;
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 50%;
}

.contact-journey__final-orbit span:nth-child(2) {
  inset: 60px;
}

.contact-journey__final-orbit span:nth-child(3) {
  inset: 120px;
}

@media (max-width: 700px) {
  .contact-journey {
    min-height: auto;
    padding-top: 7rem;
  }

  .contact-journey__path {
    min-height: auto;
    margin-top: 4rem;
    padding: 1rem 0 3rem;
  }

  .contact-journey__line {
    display: none;
  }

  .contact-journey__card,
  .contact-journey__card--1,
  .contact-journey__card--2,
  .contact-journey__card--3 {
    position: relative;
    top: auto;
    left: auto;
    right: auto;
    width: 100%;
    margin: 0 0 2rem;
  }

  .contact-journey__image-wrap {
    height: 240px;
  }

  .contact-journey__final {
    padding: 6rem 1rem;
  }

  .contact-journey__final-orbit {
    width: 320px;
    height: 320px;
  }
}
