.hero {
  position: relative;
  background: var(--cream);
  padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(4rem, 8vw, 6rem);
  overflow: hidden;
}

.hero__grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
  gap: clamp(2rem, 5vw, 4rem);
  align-items: center;
}

/* ===== Left column ===== */
.hero__greeting {
  font-size: 1.05rem;
  font-weight: 500;
  color: var(--navy-soft);
}

.hero__content {
  position: relative;
}

.hero__title {
  position: relative;
  z-index: 1;
  margin-top: 0.75rem;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(2.9rem, 6.4vw, 5rem);
  font-weight: 500;
  line-height: 1.08;
  letter-spacing: -0.015em;
  color: #0a0a0a;
  letter-spacing: -0.035em;
}

.hero__line {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.hero__badge {
  padding: 0.18em 0.45em;
  border-radius: 0;
  padding-inline: 0.22em;
  background: #0a0a0a;
  color: #ffffff;
  font-family: 'Mulish', sans-serif;
  font-size: 0.44em;
  font-weight: 800;
  letter-spacing: 0;
  line-height: 1.2;
}

.hero__intro {
  position: relative;
  z-index: 1;
  margin-top: 1.75rem;
  max-width: 34rem;
  font-family: 'Mulish', sans-serif;
  font-size: clamp(1.05rem, 1.6vw, 1.25rem);
  font-weight: 500;
  line-height: 1.6;
  color: #3a3b44;
}

.hero__cta {
  margin-top: 1.75rem;
}



/* ===== Stats ===== */
.hero__stats {
  display: flex;
  flex-wrap: wrap;
  gap: clamp(1.5rem, 5vw, 3.5rem);
  margin-top: clamp(2.5rem, 5vw, 3.5rem);
}

.hero__stat {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}

.hero__stat dt {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 700;
  color: var(--pink);
}

.hero__stat dd {
  margin: 0;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--navy-soft);
}

/* ===== Right column ===== */
.hero__media {
  position: relative;
  isolation: isolate;
}

/* The photo covers the robot, so only its head shows above the edge */
.hero__photo {
  position: relative;
  z-index: 1;
}

.hero__photo {
  border-radius: var(--radius-md);
  overflow: hidden;
  background: linear-gradient(160deg, #c8265a, #8e1b46);
  aspect-ratio: 4 / 5;
}

.hero__photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero__badge-wrap {
  position: absolute;
  right: -34px;
  bottom: 34px;
}

/* ===== Tablet ===== */
@media (max-width: 900px) {
  .hero__grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .hero__media {
    max-width: 26rem;
  }

  .hero__badge-wrap {
    right: -20px;
  }
}

/* ===== Mobile ===== */
@media (max-width: 600px) {
  .hero__badge-wrap {
    right: 8px;
    bottom: 12px;
  }
}

/* Berry pink under the cursor */
.hero .hero__cta.btn:hover,
.hero .hero__cta.btn:focus-visible {
  background: #ba406a;
  color: #ffffff;
}

/* ===== Badge notch =====
   A round bite is cut from the photo's bottom-right corner with a
   radial-gradient mask, and the resume badge sits inside that bite.
   --notch-at is how far the bite's centre sits in from the corner;
   --notch-r is the badge radius plus a small gap. */
.hero__media {
  --notch-at: 40px;
  --notch-r: calc(64px + 12px);
}

.hero__photo {
  aspect-ratio: 5 / 6;
  max-width: 440px;
  margin-left: auto;
  border-radius: 28px;
  -webkit-mask-image: radial-gradient(
    circle at calc(100% - var(--notch-at)) calc(100% - var(--notch-at)),
    transparent var(--notch-r),
    #000 calc(var(--notch-r) + 0.5px)
  );
  mask-image: radial-gradient(
    circle at calc(100% - var(--notch-at)) calc(100% - var(--notch-at)),
    transparent var(--notch-r),
    #000 calc(var(--notch-r) + 0.5px)
  );
  animation: hero-photo-in 1s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.hero__photo img {
  transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
}

.hero__photo:hover img {
  transform: scale(1.04);
}

/* Centre the badge on the bite (badge is 128px, so half is 64px) */
.hero .hero__badge-wrap {
  right: calc(var(--notch-at) - 64px);
  bottom: calc(var(--notch-at) - 64px);
}

@keyframes hero-photo-in {
  from {
    opacity: 0;
    transform: translateY(28px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* The badge shrinks to 104px on phones, so the bite shrinks with it */
@media (max-width: 600px) {
  .hero__media {
    --notch-at: 34px;
    --notch-r: calc(52px + 10px);
  }

  .hero .hero__badge-wrap {
    right: calc(var(--notch-at) - 52px);
    bottom: calc(var(--notch-at) - 52px);
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero__photo {
    animation: none;
  }
}
