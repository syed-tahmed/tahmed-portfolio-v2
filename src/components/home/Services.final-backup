.services-section {
  width: 100%;
  background: #050506;
  color: #f5f5f5;
  padding: 150px 0 180px;
  overflow: hidden;
}

.services-container {
  width: min(1380px, calc(100% - 80px));
  margin: 0 auto;
}

.services-intro {
  margin-bottom: 100px;
}

.services-eyebrow {
  margin: 0 0 28px;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.22em;
  color: #77777f;
}

.services-intro h2 {
  margin: 0;
  max-width: 1000px;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(58px, 7vw, 112px);
  line-height: 0.94;
  font-weight: 400;
  letter-spacing: -0.055em;
}

.services-lead {
  max-width: 900px;
  margin: 42px 0 0;
  font-family: Arial, Helvetica, sans-serif;
  font-size: clamp(18px, 1.8vw, 25px);
  line-height: 1.45;
  color: #8d8d95;
}

.services-list {
  border-top: 1px solid #303037;
}

.service-item {
  border-bottom: 1px solid #303037;
}

.service-header {
  width: 100%;
  display: grid;
  grid-template-columns: 80px 1fr 90px;
  align-items: center;
  gap: 20px;
  padding: 48px 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: #f5f5f5;
  text-align: left;
  cursor: pointer;
}

.service-number {
  font-family: Arial, Helvetica, sans-serif;
  font-size: 13px;
  letter-spacing: 0.12em;
  color: #686870;
}

.service-title {
  font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
  font-size: clamp(54px, 7vw, 118px);
  line-height: 0.88;
  letter-spacing: -0.025em;
  font-weight: 400;
  transition:
    transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 0.4s ease;
}

.service-item:not(.is-active) .service-title {
  opacity: 0.92;
}

.service-header:hover .service-title {
  transform: translateX(12px);
}

.service-toggle {
  width: 76px;
  height: 76px;
  display: grid;
  place-items: center;
  border: 1px solid #5b5b64;
  border-radius: 50%;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 34px;
  font-weight: 200;
  justify-self: end;
  transition:
    background 0.4s ease,
    color 0.4s ease,
    transform 0.4s ease;
}

.service-item.is-active .service-toggle {
  background: #f5f5f5;
  color: #050506;
  transform: rotate(180deg);
}

.service-content {
  display: grid;
  grid-template-rows: 0fr;
  opacity: 0;
  transition:
    grid-template-rows 0.75s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 0.5s ease;
}

.service-content.is-open {
  grid-template-rows: 1fr;
  opacity: 1;
}

.service-content-inner {
  min-height: 0;
  overflow: hidden;
  display: grid;
  grid-template-columns: 0.72fr 1.28fr;
  gap: 90px;
  padding: 0 0 72px 80px;
}

.service-copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 35px 0;
}

.service-description {
  max-width: 560px;
  margin: 0 0 38px;
  font-family: Arial, Helvetica, sans-serif;
  font-size: clamp(18px, 1.7vw, 25px);
  line-height: 1.5;
  color: #909098;
}

.service-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 48px;
}

.service-tags span {
  padding: 13px 19px;
  border: 1px solid #34343b;
  border-radius: 100px;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 11px;
  letter-spacing: 0.1em;
  color: #b4b4bb;
  white-space: nowrap;
}

.service-link {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  width: fit-content;
  color: #f5f5f5;
  text-decoration: none;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 17px;
  transition: gap 0.35s ease;
}

.service-link span {
  font-size: 25px;
}

.service-link:hover {
  gap: 22px;
}

.service-image-wrap {
  width: 100%;
  aspect-ratio: 1.75 / 1;
  overflow: hidden;
  border-radius: 30px;
  background: #111116;
}

.service-image {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  filter: saturate(0.92);
  transform: scale(1.03);
  transition:
    transform 1.2s cubic-bezier(0.22, 1, 0.36, 1),
    filter 0.6s ease;
}

.service-item.is-active .service-image {
  transform: scale(1);
  filter: saturate(1);
}

.service-image-wrap:hover .service-image {
  transform: scale(1.035);
}

/* tablet */

@media (max-width: 1000px) {
  .services-section {
    padding: 110px 0 130px;
  }

  .services-container {
    width: min(100% - 44px, 850px);
  }

  .services-intro {
    margin-bottom: 70px;
  }

  .service-header {
    grid-template-columns: 55px 1fr 65px;
    padding: 38px 0;
  }

  .service-toggle {
    width: 58px;
    height: 58px;
    font-size: 28px;
  }

  .service-content-inner {
    grid-template-columns: 1fr;
    gap: 45px;
    padding: 0 0 55px 55px;
  }

  .service-image-wrap {
    aspect-ratio: 1.8 / 1;
  }
}

/* mobile */

@media (max-width: 650px) {
  .services-section {
    padding: 85px 0 100px;
  }

  .services-container {
    width: calc(100% - 32px);
  }

  .services-intro {
    margin-bottom: 55px;
  }

  .services-eyebrow {
    margin-bottom: 20px;
  }

  .services-intro h2 {
    font-size: clamp(48px, 15vw, 76px);
    line-height: 0.94;
  }

  .services-lead {
    margin-top: 28px;
    font-size: 17px;
  }

  .service-header {
    grid-template-columns: 38px 1fr 52px;
    gap: 8px;
    padding: 30px 0;
  }

  .service-number {
    font-size: 11px;
  }

  .service-title {
    font-size: clamp(36px, 10vw, 58px);
  }

  .service-header:hover .service-title {
    transform: none;
  }

  .service-toggle {
    width: 48px;
    height: 48px;
    font-size: 24px;
  }

  .service-content-inner {
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding: 0 0 42px;
  }

  .service-copy {
    padding: 5px 0;
  }

  .service-description {
    font-size: 17px;
    margin-bottom: 25px;
  }

  .service-tags {
    gap: 7px;
    margin-bottom: 30px;
  }

  .service-tags span {
    padding: 10px 13px;
    font-size: 9px;
  }

  .service-image-wrap {
    aspect-ratio: 1.35 / 1;
    border-radius: 20px;
  }
}
