import { useEffect, useMemo, useRef } from 'react'
import { Link } from 'react-router-dom'
import gsap from 'gsap'
import { ScrollTrigger } from 'gsap/ScrollTrigger'
import './ContactJourney.css'

gsap.registerPlugin(ScrollTrigger)

// Optional: paste wide landscape image URLs here. Empty = CSS/SVG silhouettes only.
const IMAGES = { far: '', mid: '', near: '' }

function ridge(seed, base, amp, step = 40) {
  let s = seed * 9301 + 49297
  const rnd = () => ((s = (s * 16807) % 2147483647) / 2147483647)
  let d = `M0 600 L0 ${base}`
  for (let x = 0; x <= 1600; x += step) {
    const y =
      base -
      amp *
        (0.6 * (1 - Math.abs(Math.sin(x / 230 + seed))) +
          0.3 * (1 - Math.abs(Math.sin(x / 90 + seed * 3))) +
          0.25 * rnd())
    d += ` L${x} ${y.toFixed(1)}`
  }
  return d + ' L1600 600 Z'
}

function Layer({ name, path, gradId, c1, c2, img }) {
  return (
    <div className={`cj-layer cj-${name}`} aria-hidden="true">
      {img ? (
        <img className="cj-photo" src={img} alt="" loading="lazy" decoding="async"
             onError={(e) => { e.currentTarget.style.display = 'none' }} />
      ) : null}
      <svg viewBox="0 0 1600 600" preserveAspectRatio="xMidYMax slice">
        <defs>
          <linearGradient id={gradId} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stopColor={c1} />
            <stop offset="1" stopColor={c2} />
          </linearGradient>
        </defs>
        <path d={path} fill={`url(#${gradId})`} />
      </svg>
    </div>
  )
}

export default function ContactJourney() {
  const root = useRef(null)
  const counter = useRef(null)

  const paths = useMemo(
    () => ({ far: ridge(2, 300, 170), mid: ridge(5, 370, 210), near: ridge(9, 450, 230, 32) }),
    []
  )
  const particles = useMemo(
    () => Array.from({ length: 34 }, (_, i) => ({
      x: (i * 37) % 100, y: (i * 53) % 100,
      s: 1 + (i % 3), d: 14 + (i % 7) * 3, o: (i % 5) * -3,
    })),
    []
  )

  useEffect(() => {
    const mm = gsap.matchMedia()
    const ctx = gsap.context(() => {
      mm.add(
        { motion: '(prefers-reduced-motion: no-preference)', small: '(max-width: 700px)' },
        (c) => {
          const small = c.conditions.small
          const k = small ? 0.65 : 1
          const state = { v: 0 }

          const tl = gsap.timeline({
            defaults: { ease: 'none' },
            scrollTrigger: {
              trigger: root.current,
              start: 'top top',
              end: small ? '+=380%' : '+=480%',
              pin: true,
              scrub: 1.6,
              anticipatePin: 1,
            },
          })

          tl.to('.cj-veil', { opacity: 0, duration: 2 }, 0)
            .to('.cj-far', { scale: 1 + 0.25 * k, yPercent: -2, duration: 10 }, 0)
            .to('.cj-mid', { scale: 1 + 0.7 * k, yPercent: 6, duration: 10 }, 0)
            .to('.cj-near', { scale: 1 + 1.6 * k, yPercent: 28, duration: 10 }, 0)
            .to('.cj-glow', { opacity: 1, yPercent: -18, duration: 6 }, 4)
            .to('.cj-fog', { opacity: 0.75, duration: 5 }, 1)
            .to(state, {
              v: 100, duration: 10,
              onUpdate: () => {
                if (counter.current) counter.current.textContent = String(Math.round(state.v)).padStart(3, '0')
              },
            }, 0)
            // chapter one
            .fromTo('.cj-c1 .cj-line > span', { yPercent: 110 }, { yPercent: 0, stagger: 0.25, duration: 1.2 }, 1.2)
            .to('.cj-c1', { opacity: 0, duration: 1 }, 3.6)
            // chapter two
            .fromTo('.cj-c2 .cj-line > span', { yPercent: 110 }, { yPercent: 0, stagger: 0.25, duration: 1.2 }, 4.2)
            .to('.cj-c2', { opacity: 0, duration: 1 }, 6.4)
            // destination
            .fromTo('.cj-final', { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: 1.6 }, 7.2)
            .fromTo('.cj-cta', { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, duration: 1 }, 8.8)
        }
      )
    }, root)

    return () => {
      mm.revert()
      ctx.revert()
    }
  }, [])

  return (
    <section className="cj" ref={root} aria-label="Contact">
      <div className="cj-sky" aria-hidden="true" />
      <div className="cj-glow" aria-hidden="true" />
      <Layer name="far" path={paths.far} gradId="cjg1" c1="#16304f" c2="#0a1626" img={IMAGES.far} />
      <div className="cj-fog cj-fog-a" aria-hidden="true" />
      <Layer name="mid" path={paths.mid} gradId="cjg2" c1="#0c1c31" c2="#050d18" img={IMAGES.mid} />
      <div className="cj-fog cj-fog-b" aria-hidden="true" />
      <Layer name="near" path={paths.near} gradId="cjg3" c1="#050c17" c2="#01040a" img={IMAGES.near} />

      <div className="cj-particles" aria-hidden="true">
        {particles.map((p, i) => (
          <i key={i} style={{ left: p.x + '%', top: p.y + '%', width: p.s, height: p.s,
            animationDuration: p.d + 's', animationDelay: p.o + 's' }} />
        ))}
      </div>
      <div className="cj-grain" aria-hidden="true" />
      <div className="cj-veil" aria-hidden="true" />

      <div className="cj-hud" aria-hidden="true">
        <span>Distance</span>
        <b ref={counter}>000</b>
      </div>

      <div className="cj-copy cj-c1" aria-hidden="true">
        <h3>
          <span className="cj-line"><span>Past the work,</span></span>
          <span className="cj-line"><span>there is open ground.</span></span>
        </h3>
      </div>
      <div className="cj-copy cj-c2" aria-hidden="true">
        <h3>
          <span className="cj-line"><span>Keep walking.</span></span>
          <span className="cj-line"><span>The light is ahead.</span></span>
        </h3>
      </div>

      <div className="cj-copy cj-final">
        <h2>Let me know if you want to talk about a potential collaboration.</h2>
        <p>I am available for freelance work.</p>
        <Link to="/contact" className="cj-cta">
          <span>Contact me</span>
          <svg width="22" height="12" viewBox="0 0 22 12" aria-hidden="true">
            <path d="M0 6h20M15 1l5 5-5 5" fill="none" stroke="currentColor" strokeWidth="1.4" />
          </svg>
        </Link>
      </div>
    </section>
  )
}
