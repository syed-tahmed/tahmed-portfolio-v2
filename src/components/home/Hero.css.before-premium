.hero {
  position: relative;
  background: var(--cream);
  padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(4rem, 8vw, 6rem);
  overflow: hidden;
}

.hero__grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
  gap: clamp(2rem, 5vw, 4rem);
  align-items: center;
}

/* ===== Left column ===== */
.hero__greeting {
  font-size: 1.05rem;
  font-weight: 500;
  color: var(--navy-soft);
}

.hero__content {
  position: relative;
}

.hero__title {
  position: relative;
  z-index: 1;
  margin-top: 0.75rem;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(2.9rem, 6.4vw, 5rem);
  font-weight: 500;
  line-height: 1.08;
  letter-spacing: -0.015em;
  color: #0a0a0a;
  letter-spacing: -0.035em;
}

.hero__line {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.hero__badge {
  padding: 0.18em 0.45em;
  border-radius: 0;
  padding-inline: 0.22em;
  background: #0a0a0a;
  color: #ffffff;
  font-family: 'Mulish', sans-serif;
  font-size: 0.44em;
  font-weight: 800;
  letter-spacing: 0;
  line-height: 1.2;
}

.hero__intro {
  position: relative;
  z-index: 1;
  margin-top: 1.75rem;
  max-width: 34rem;
  font-family: 'Mulish', sans-serif;
  font-size: clamp(1.05rem, 1.6vw, 1.25rem);
  font-weight: 500;
  line-height: 1.6;
  color: #3a3b44;
}

.hero__cta {
  margin-top: 1.75rem;
}



/* ===== Stats ===== */
.hero__stats {
  display: flex;
  flex-wrap: wrap;
  gap: clamp(1.5rem, 5vw, 3.5rem);
  margin-top: clamp(2.5rem, 5vw, 3.5rem);
}

.hero__stat {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}

.hero__stat dt {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 700;
  color: var(--pink);
}

.hero__stat dd {
  margin: 0;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--navy-soft);
}

/* ===== Right column ===== */
.hero__media {
  position: relative;
  isolation: isolate;
}

/* The photo covers the robot, so only its head shows above the edge */
.hero__photo {
  position: relative;
  z-index: 1;
}

.hero__photo {
  border-radius: var(--radius-md);
  overflow: hidden;
  background: linear-gradient(160deg, #c8265a, #8e1b46);
  aspect-ratio: 4 / 5;
}

.hero__photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero__badge-wrap {
  position: absolute;
  right: -34px;
  bottom: 34px;
}

/* ===== Tablet ===== */
@media (max-width: 900px) {
  .hero__grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .hero__media {
    max-width: 26rem;
  }

  .hero__badge-wrap {
    right: -20px;
  }
}

/* ===== Mobile ===== */
@media (max-width: 600px) {
  .hero__badge-wrap {
    right: 8px;
    bottom: 12px;
  }
}

/* Berry pink under the cursor */
.hero .hero__cta.btn:hover,
.hero .hero__cta.btn:focus-visible {
  background: #ba406a;
  color: #ffffff;
}

/* ===== Badge notch =====
   A round bite is cut from the photo's bottom-right corner with a
   radial-gradient mask, and the resume badge sits inside that bite.
   --notch-at is how far the bite's centre sits in from the corner;
   --notch-r is the badge radius plus a small gap. */
.hero__media {
  --notch-at: 40px;
  --notch-r: calc(64px + 12px);
}

.hero__photo {
  aspect-ratio: 5 / 6;
  max-width: 440px;
  margin-left: auto;
  border-radius: 28px;
  -webkit-mask-image: radial-gradient(
    circle at calc(100% - var(--notch-at)) calc(100% - var(--notch-at)),
    transparent var(--notch-r),
    #000 calc(var(--notch-r) + 0.5px)
  );
  mask-image: radial-gradient(
    circle at calc(100% - var(--notch-at)) calc(100% - var(--notch-at)),
    transparent var(--notch-r),
    #000 calc(var(--notch-r) + 0.5px)
  );
  animation: hero-photo-in 1s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.hero__photo img {
  transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
}

.hero__photo:hover img {
  transform: scale(1.04);
}

/* Centre the badge on the bite (badge is 128px, so half is 64px) */
.hero .hero__badge-wrap {
  right: calc(var(--notch-at) - 64px);
  bottom: calc(var(--notch-at) - 64px);
}

@keyframes hero-photo-in {
  from {
    opacity: 0;
    transform: translateY(28px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* The badge shrinks to 104px on phones, so the bite shrinks with it */
@media (max-width: 600px) {
  .hero__media {
    --notch-at: 34px;
    --notch-r: calc(52px + 10px);
  }

  .hero .hero__badge-wrap {
    right: calc(var(--notch-at) - 52px);
    bottom: calc(var(--notch-at) - 52px);
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero__photo {
    animation: none;
  }
}


/* =========================================================
   PREMIUM EDITORIAL HERO HEADING
   ========================================================= */

.hero__eyebrow {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  margin-bottom: 1rem;

  font-family: 'Mulish', sans-serif;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;

  color: var(--navy-soft);
  opacity: 0;
  animation: hero-eyebrow-in 0.7s ease 0.05s forwards;
}

.hero__eyebrow-dot {
  width: 7px;
  height: 7px;
  flex: 0 0 7px;
  border-radius: 50%;
  background: #BA406A;
}

.hero__eyebrow-line {
  width: clamp(24px, 4vw, 60px);
  height: 1px;
  background: currentColor;
  opacity: 0.35;
}


/* Main editorial typography */

.hero__title {
  font-size: clamp(3.5rem, 7.5vw, 7rem);
  line-height: 0.94;
  letter-spacing: -0.045em;
  font-weight: 500;
  max-width: 900px;
}


/* Each line becomes its own reveal */

.hero__line--reveal {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
}

.hero__line--reveal > span {
  display: inline-block;
  transform: translateY(115%);
  opacity: 0;

  animation:
    hero-title-reveal 1s cubic-bezier(0.16, 1, 0.3, 1)
    forwards;
}

.hero__line--second > span {
  animation-delay: 0.12s;
}


/* Make the second line feel intentionally offset */

.hero__line--second {
  margin-left: clamp(0rem, 3vw, 3rem);
  margin-top: 0.08em;
}


/* Keep your existing pink Product badge */

.hero__line--second .hero__badge {
  position: relative;
  z-index: 2;
  flex-shrink: 0;

  transform: translateY(115%);
  opacity: 0;

  animation:
    hero-badge-reveal 0.9s cubic-bezier(0.16, 1, 0.3, 1)
    0.12s forwards;
}


/* Small editorial line underneath heading */

.hero__title::after {
  content: "";
  display: block;

  width: min(100%, 560px);
  height: 1px;

  margin-top: clamp(1.4rem, 2.5vw, 2rem);

  background: #1d1d22;
  opacity: 0.12;

  transform-origin: left;
  transform: scaleX(0);

  animation: hero-line-reveal 1s cubic-bezier(0.16, 1, 0.3, 1) 0.45s forwards;
}


/* Animations */

@keyframes hero-title-reveal {
  from {
    transform: translateY(115%);
    opacity: 0;
  }

  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes hero-badge-reveal {
  from {
    transform: translateY(115%);
    opacity: 0;
  }

  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes hero-eyebrow-in {
  from {
    transform: translateY(10px);
    opacity: 0;
  }

  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes hero-line-reveal {
  from {
    transform: scaleX(0);
  }

  to {
    transform: scaleX(1);
  }
}


/* Mobile */

@media (max-width: 600px) {
  .hero__eyebrow {
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.62rem;
  }

  .hero__title {
    font-size: clamp(3rem, 14vw, 5rem);
    line-height: 0.96;
  }

  .hero__line--second {
    margin-left: 0;
  }

  .hero__title::after {
    margin-top: 1.2rem;
  }
}


/* Accessibility */

@media (prefers-reduced-motion: reduce) {
  .hero__eyebrow,
  .hero__line--reveal > span,
  .hero__line--second .hero__badge,
  .hero__title::after {
    animation: none;
    transform: none;
    opacity: 1;
  }
}
