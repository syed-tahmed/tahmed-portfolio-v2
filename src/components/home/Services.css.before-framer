.services {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #03050b !important;
  color: #fff !important;
  padding: 140px 0 180px;
}

.services__container {
  width: min(1240px, calc(100% - 80px));
  margin: 0 auto;
}

.services__intro {
  max-width: 820px;
  margin-bottom: 90px;
}

.services__eyebrow {
  display: block !important;
  margin-bottom: 24px;
  font-family: Inter, Arial, sans-serif !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  letter-spacing: .2em;
  color: rgba(255,255,255,.45) !important;
}

.services__intro h2 {
  margin: 0 !important;
  font-family: Inter, Arial, sans-serif !important;
  font-size: clamp(48px, 7vw, 90px) !important;
  line-height: .94 !important;
  letter-spacing: -.055em !important;
  font-weight: 700 !important;
  color: #fff !important;
}

.services__intro h2 span {
  color: rgba(255,255,255,.35) !important;
}

.services__intro p {
  max-width: 650px;
  margin: 32px 0 0 !important;
  font-family: Inter, Arial, sans-serif !important;
  font-size: 18px !important;
  line-height: 1.6 !important;
  color: rgba(255,255,255,.48) !important;
}

.services__accordion {
  width: 100%;
  border-top: 1px solid rgba(255,255,255,.25);
}

.service-item {
  width: 100%;
  border-bottom: 1px solid rgba(255,255,255,.25);
}

.service-item__trigger {
  appearance: none !important;
  -webkit-appearance: none !important;
  display: grid !important;
  grid-template-columns: 70px 1fr 64px !important;
  align-items: center !important;
  width: 100% !important;
  min-height: 150px !important;
  padding: 0 !important;
  margin: 0 !important;
  border: 0 !important;
  outline: 0 !important;
  background: transparent !important;
  color: #fff !important;
  cursor: pointer !important;
  text-align: left !important;
}

.service-item__number {
  font-family: Inter, Arial, sans-serif !important;
  font-size: 13px !important;
  color: rgba(255,255,255,.4) !important;
}

.service-item__title {
  display: block !important;
  font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif !important;
  font-size: clamp(45px, 6vw, 82px) !important;
  line-height: .9 !important;
  font-weight: 400 !important;
  letter-spacing: -.015em !important;
  text-transform: uppercase !important;
  color: #fff !important;
  transition: transform .5s cubic-bezier(.22,1,.36,1);
}

.service-item:hover .service-item__title {
  transform: translateX(12px);
}

.service-item__icon {
  position: relative !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 58px !important;
  height: 58px !important;
  border: 1px solid rgba(255,255,255,.5) !important;
  border-radius: 50% !important;
  flex-shrink: 0;
  background: transparent !important;
}

.service-item__icon span {
  position: absolute !important;
  width: 20px !important;
  height: 1px !important;
  background: #fff !important;
}

.service-item__icon span:last-child {
  transform: rotate(90deg);
  transition: transform .4s ease;
}

.service-item.is-open .service-item__icon {
  background: #fff !important;
}

.service-item.is-open .service-item__icon span {
  background: #05070d !important;
}

.service-item.is-open .service-item__icon span:last-child {
  transform: rotate(0deg);
}

.service-item__content {
  display: grid !important;
  grid-template-rows: 0fr;
  overflow: hidden !important;
  opacity: 0;
  transition:
    grid-template-rows .75s cubic-bezier(.22,1,.36,1),
    opacity .45s ease;
}

.service-item.is-open .service-item__content {
  grid-template-rows: 1fr;
  opacity: 1;
}

.service-item__inner {
  min-height: 0;
  overflow: hidden;
  display: grid !important;
  grid-template-columns: .8fr 1.2fr !important;
  gap: 70px !important;
  padding: 0 0 70px !important;
}

.service-item__meta {
  display: flex !important;
  flex-direction: column !important;
  justify-content: flex-end !important;
  min-height: 400px !important;
}

.service-item__description p {
  max-width: 480px;
  margin: 0 !important;
  font-family: Inter, Arial, sans-serif !important;
  font-size: 17px !important;
  line-height: 1.7 !important;
  color: rgba(255,255,255,.55) !important;
}

.service-item__categories {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 9px !important;
  margin-top: 30px !important;
}

.service-item__categories span {
  display: inline-block !important;
  padding: 9px 14px !important;
  border: 1px solid rgba(255,255,255,.2) !important;
  border-radius: 100px !important;
  font-family: Inter, Arial, sans-serif !important;
  font-size: 10px !important;
  letter-spacing: .08em !important;
  text-transform: uppercase !important;
  color: rgba(255,255,255,.7) !important;
}

.service-item__link {
  display: inline-flex !important;
  align-items: center !important;
  gap: 12px !important;
  width: fit-content !important;
  margin-top: 38px !important;
  font-family: Inter, Arial, sans-serif !important;
  font-size: 14px !important;
  color: #fff !important;
  text-decoration: none !important;
}

.service-item__link span {
  font-size: 20px;
}

.service-item__image-wrap {
  position: relative !important;
  width: 100% !important;
  height: 430px !important;
  overflow: hidden !important;
  border-radius: 26px !important;
  background: #111522 !important;
  opacity: 0;
  transform: translateY(35px);
  transition:
    opacity .7s ease,
    transform .8s cubic-bezier(.22,1,.36,1);
}

.service-item.is-open .service-item__image-wrap {
  opacity: 1;
  transform: translateY(0);
}

.service-item__image-wrap img {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  margin: 0 !important;
  padding: 0 !important;
  transform: scale(1.08);
  transition: transform 1s cubic-bezier(.22,1,.36,1);
}

.service-item.is-open .service-item__image-wrap img {
  transform: scale(1);
}

.service-item__image-wrap::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    transparent 40%,
    rgba(0,0,0,.45)
  );
  pointer-events: none;
}

@media (max-width: 900px) {
  .services {
    padding: 100px 0 130px;
  }

  .services__container {
    width: calc(100% - 40px);
  }

  .service-item__trigger {
    grid-template-columns: 45px 1fr 55px !important;
    min-height: 110px !important;
  }

  .service-item__title {
    font-size: clamp(36px, 8vw, 65px) !important;
  }

  .service-item__inner {
    grid-template-columns: 1fr !important;
    gap: 40px !important;
  }

  .service-item__meta {
    min-height: auto !important;
  }

  .service-item__image-wrap {
    height: 330px !important;
  }
}

@media (max-width: 600px) {
  .services {
    padding: 80px 0 100px;
  }

  .services__container {
    width: calc(100% - 28px);
  }

  .services__intro h2 {
    font-size: 46px !important;
  }

  .service-item__trigger {
    grid-template-columns: 32px 1fr 46px !important;
    min-height: 90px !important;
  }

  .service-item__title {
    font-size: 34px !important;
  }

  .service-item__icon {
    width: 42px !important;
    height: 42px !important;
  }

  .service-item__image-wrap {
    height: 240px !important;
    border-radius: 18px !important;
  }
}
