@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=Manrope:wght@300;400;500&display=swap');

.cj{position:relative;height:100vh;height:100svh;overflow:hidden;background:#02050b;color:#e6eef7;
  font-family:'Manrope',system-ui,sans-serif;isolation:isolate}
.cj>*{position:absolute;inset:0}
.cj-sky{background:linear-gradient(180deg,#010308 0%,#040b17 45%,#0a1a2f 100%)}
.cj-glow{opacity:0;background:radial-gradient(60% 45% at 50% 62%,rgba(90,150,220,.38),rgba(40,80,140,.12) 55%,transparent 75%);
  will-change:transform,opacity}
.cj-layer{transform-origin:50% 100%;will-change:transform}
.cj-layer svg{width:100%;height:100%;display:block}
.cj-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.35;mix-blend-mode:luminosity;
  -webkit-mask-image:linear-gradient(#000 40%,transparent);mask-image:linear-gradient(#000 40%,transparent)}
.cj-fog{opacity:.2;pointer-events:none;will-change:transform,opacity;
  background:radial-gradient(50% 18% at 30% 70%,rgba(120,160,210,.28),transparent 70%),
             radial-gradient(45% 16% at 75% 62%,rgba(120,160,210,.2),transparent 70%);
  width:140%;left:-20%;animation:cjdrift 38s ease-in-out infinite alternate}
.cj-fog-b{animation-duration:52s;animation-direction:alternate-reverse;top:8%}
@keyframes cjdrift{from{transform:translate3d(-6%,0,0)}to{transform:translate3d(6%,0,0)}}
.cj-particles i{position:absolute;border-radius:50%;background:rgba(190,215,255,.7);opacity:0;
  animation:cjfloat linear infinite;will-change:transform,opacity}
@keyframes cjfloat{0%{transform:translate3d(0,20px,0);opacity:0}20%{opacity:.6}100%{transform:translate3d(24px,-140px,0);opacity:0}}
.cj-grain{pointer-events:none;opacity:.08;mix-blend-mode:overlay;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>")}
.cj-veil{background:#02050b;pointer-events:none}

.cj-hud{inset:auto auto 2rem 2rem;display:flex;align-items:baseline;gap:.8rem;font-size:.8rem;letter-spacing:.14em;
  text-transform:uppercase;color:rgba(200,220,245,.6);z-index:3}
.cj-hud b{font-weight:300;font-size:1.6rem;letter-spacing:.04em;font-variant-numeric:tabular-nums;color:#e6eef7}

.cj-copy{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;
  padding:0 1.5rem;z-index:2;pointer-events:none}
.cj-copy h3,.cj-copy h2{font-family:'Cormorant Garamond',Georgia,serif;font-weight:300;line-height:1.02;letter-spacing:-.01em}
.cj-copy h3{font-size:clamp(2.6rem,8vw,7.5rem)}
.cj-line{display:block;overflow:hidden;padding-bottom:.08em}
.cj-line>span{display:block;will-change:transform}
.cj-final{opacity:0;visibility:hidden;pointer-events:auto;gap:1.6rem}
.cj-final h2{font-size:clamp(2.2rem,6vw,5.6rem);max-width:16ch;font-style:italic}
.cj-final p{font-size:clamp(.95rem,1.5vw,1.15rem);letter-spacing:.04em;color:rgba(210,226,245,.78)}
.cj-cta{display:inline-flex;align-items:center;gap:1rem;padding:1rem 1.9rem;border:1px solid rgba(190,215,255,.55);
  border-radius:999px;color:#e6eef7;text-decoration:none;font-weight:500;letter-spacing:.06em;
  transition:background .5s ease,color .5s ease,border-color .5s ease}
.cj-cta svg{transition:transform .5s ease}
.cj-cta:hover,.cj-cta:focus-visible{background:#e6eef7;color:#02050b;border-color:#e6eef7;outline:none}
.cj-cta:hover svg,.cj-cta:focus-visible svg{transform:translateX(6px)}

@media (max-width:700px){
  .cj-hud{inset:auto auto 1.2rem 1.2rem}
  .cj-fog-b,.cj-particles i:nth-child(n+16){display:none}
}
@media (prefers-reduced-motion:reduce){
  .cj-veil,.cj-c1,.cj-c2,.cj-hud,.cj-particles{display:none}
  .cj-fog,.cj-particles i{animation:none}
  .cj-glow{opacity:1}
  .cj-final{opacity:1!important;visibility:visible!important;transform:none!important}
  .cj-layer{transform:none!important}
}
